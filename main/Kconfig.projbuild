menu "AURA Mesh Intermediary Configuration"

    config AURA_MESH_AP_PASSWORD
        string "Mesh AP Password"
        default "clave-mesh-aura"
        help
            Clave de red WPA2 para la malla ESP-WIFI-MESH.

    config AURA_DEFAULT_AULA
        string "Aula por defecto"
        default "aula1"
        help
            Identificador del aula inicial para filtrado y Vendor IE si NVS está vacía.

endmenu
